# ==============================================================
# إعدادات مشروع صفقات (Safaqat) - رادار الصفقات والوساطة الذكية في غزة
# ==============================================================

# مفتاح Google Gemini API لمعالجة الفيديوهات والنصوص وتصنيف المتاجر
GEMINI_API_KEY=your_gemini_api_key_here

# توكن بوت تليجرام للتنبيهات المشفرة
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# معرف قناة التليجرام العامة أو الخاصة للبث (اختياري)
TELEGRAM_BROADCAST_CHAT_ID=

# إعدادات قاعدة البيانات المحلية
DATABASE_PATH=safaqat.db

# مسار مجلد حفظ الوسائط المؤقتة (فيديوهات وصوتيات)
MEDIA_TEMP_DIR=temp_media

# الفاصل الزمني بالدقائق لفحص التحديثات والمتاجر الجديدة
MONITOR_INTERVAL_MINUTES=15
DISCOVERY_INTERVAL_HOURS=6
